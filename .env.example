# Model selection and checkpoint locations (relative paths are project-root-relative).
VINBIGDATA_MODEL=convnext_tiny
VINBIGDATA_CHECKPOINT=checkpoints/convnext_tiny/convnext_tiny_weak_classes_best.pth
VINBIGDATA_PROTOTYPE_CHECKPOINT=checkpoints/prototype/prototype_network_full_training_final.pt
VINBIGDATA_PROTOTYPE_MANIFEST=configs/prototype/P4_v2_prototype_evidence_manifest.csv
VINBIGDATA_PROTOTYPE_IMAGE_DIR=assets/prototype_evidence

# Optional calibration/threshold artifacts.
VINBIGDATA_THRESHOLDS=configs/thresholds/best_validation_thresholds_weak_tuned.csv
VINBIGDATA_CALIBRATION_REPORT=runtime/calibration/calibration_report.json
